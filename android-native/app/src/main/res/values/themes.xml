<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The real theme (colors, typography) lives in Compose's Theme.kt —
         this is only what Android needs before Compose takes over the
         first frame, so cold start doesn't flash white. -->
    <style name="Theme.PalouseFellowshipAudio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_cream</item>
        <item name="android:statusBarColor">@color/brand_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Cold-start splash (Android 12+ SplashScreen API, backported by
         androidx.core:core-splashscreen down to this app's minSdk) — same
         logo and background as the launcher icon (@mipmap/ic_launcher,
         @color/ic_launcher_background), so app icon → splash → first
         frame reads as one continuous brand, not three different looks.
         Set as MainActivity's manifest theme; installSplashScreen() in
         MainActivity.onCreate() swaps to postSplashScreenTheme once the
         first frame is ready. -->
    <style name="Theme.PalouseFellowshipAudio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PalouseFellowshipAudio</item>
    </style>
</resources>
