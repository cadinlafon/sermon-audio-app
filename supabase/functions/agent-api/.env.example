# Supabase secrets for agent-api. Set with `npx supabase secrets set NAME=value`.
# Never put real values in this file.
PF_FIREBASE_PROJECT_ID=your-firebase-project-id
PF_FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}   # contents of the service-account JSON
PF_BACKBLAZE_BUCKET_ID=your-bucket-id
PF_BACKBLAZE_ADMIN_KEY_ID=your-key-id
PF_BACKBLAZE_ADMIN_APPLICATION_KEY=your-application-key
# New: origin of the web app that serves /agent-authorize (OAuth consent screen, needed for ChatGPT)
PF_APP_URL=https://your-app.example
